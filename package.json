{
  "name": "mikang-bookmark-memo",
  "productName": "PeeKit",
  "version": "0.2.5",
  "description": "바탕화면 책갈피 메모 + AI 비서 캐릭터 (Electron, Windows/macOS)",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "mikangscone",
  "scripts": {
    "start:direct": "npm run build:pet && electron . --direct-api",
    "start:integrations": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File server/start-local.ps1",
    "start": "npm run build:pet && electron .",
    "build:pet": "tsc -p pet/tsconfig.json && node pet/build.mjs",
    "test": "node --test test/*.test.js && vitest run pet",
    "dist": "npm run build:pet && electron-builder",
    "dist:win": "npm run build:pet && electron-builder --win",
    "dist:mac": "npm run build:pet && electron-builder --mac",
    "preview": "node tools/build-preview.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/jua": "5.3.0",
    "heic-convert": "2.1.0",
    "pretendard": "1.3.9",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.mikangscone.bookmarkmemo",
    "productName": "PeeKit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/kma.js",
      "src/**",
      "dist-pet/main/**",
      "dist-pet/preload/**",
      "dist-pet/renderer/**",
      "pet/LICENSE",
      "pet/LICENSE-ASSETS.md",
      "pet/src/renderer/fonts/OFL-Dongle.txt",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "pet/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": null,
      "artifactName": "${productName}-jhj-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-jhj-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PeeKit"
    },
    "portable": {
      "artifactName": "PeeKit-Windows.exe",
      "unpackDirName": true
    },
    "afterPack": "build/after-pack.js"
  }
}
