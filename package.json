{
  "name": "mikang-bookmark-memo",
  "productName": "Mikang Memo",
  "version": "0.2.0",
  "description": "바탕화면 책갈피 메모 + AI 비서 캐릭터 (Electron, Windows/macOS)",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "mikangscone",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "preview": "node tools/build-preview.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/jua": "5.3.0",
    "heic-convert": "2.1.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.mikangscone.bookmarkmemo",
    "productName": "Mikang Memo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/tray.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "녹음 메모를 받아쓰기 위해 마이크를 사용해요.",
        "NSLocationUsageDescription": "현재 위치의 날씨를 알려주기 위해 위치를 사용해요.",
        "NSLocationWhenInUseUsageDescription": "현재 위치의 날씨를 알려주기 위해 위치를 사용해요."
      },
      "identity": null,
      "artifactName": "${productName}-jhj-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-jhj-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mikang Memo"
    },
    "afterPack": "build/after-pack.js"
  }
}
